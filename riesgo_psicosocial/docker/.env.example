# -----------------------------------------------------------------------------
# Plantilla de docker/.env  (este archivo SI va a git; docker/.env NO)
#
# En cada equipo nuevo:
#   cp .env.example .env      (desde la carpeta docker/)
# y cambie los valores. docker compose lee docker/.env solo.
# -----------------------------------------------------------------------------

# --- Base de datos -----------------------------------------------------------
# La contrasena solo vale al crear la base por PRIMERA vez (volumen vacio).
# En un servidor nuevo use una larga y aleatoria, por ejemplo la salida de:
#   openssl rand -base64 24
PG_USER=erps_user
PG_PASSWORD=CAMBIE_ESTA_CONTRASENA
PG_DB=riesgo_psicosocial

# --- Puertos publicados ------------------------------------------------------
# 127.0.0.1 = solo se entra desde el propio equipo (lo seguro, y lo correcto en
# la nube, donde se entra por HTTPS con Caddy). Para abrir la Shiny a otros
# equipos de la red local: PUERTO_SHINY=7788
PUERTO_SHINY=127.0.0.1:7788
PUERTO_BD=127.0.0.1:5432
